
{
  "name": "timelock-exchange-fresh-tests",
  "version": "1.0.0",
  "description": "Run unit tests on this project.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "deploy:mainnet": "npx tsx scripts/deploy-mainnet.ts",
    "deploy:batch1": "npx tsx scripts/deploy-mainnet.ts --batch=1",
    "deploy:batch2": "npx tsx scripts/deploy-mainnet.ts --batch=2",
    "deploy:batch3": "npx tsx scripts/deploy-mainnet.ts --batch=3",
    "deploy:batch4": "npx tsx scripts/deploy-mainnet.ts --batch=4"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stacks/clarinet-sdk": "^3.9.0",
    "@stacks/network": "^7.0.0",
    "@stacks/transactions": "^7.2.0",
    "@stacks/wallet-sdk": "^7.0.0",
    "@types/node": "^24.4.0",
    "chokidar-cli": "^3.0.0",
    "tsx": "^4.19.0",
    "vitest": "^4.0.7",
    "vitest-environment-clarinet": "^3.0.0"
  }
}
